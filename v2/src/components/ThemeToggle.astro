----\n// ThemeToggle.astro\n---\n<button\n  class="theme-toggle"\n  aria-label="Alternar entre Etapa 1 e Etapa 2"\n  on:click={() => {\n    const current = document.documentElement.getAttribute('data-etapa');\n    const next = current === '1' ? '2' : '1';\n    document.documentElement.setAttribute('data-etapa', next);\n  }}\n>\n  {document.documentElement.getAttribute('data-etapa') === '1' ? 'Etapa 2' : 'Etapa 1'}\n</button>
